# =====================================================================
# Inti Taxi — variables de entorno de EJEMPLO (sin valores reales).
# Copiar a .env (ignorado por git) solo para desarrollo local.
# En staging/producción los secretos se inyectan desde AWS Secrets Manager.
# =====================================================================

# ---------- Servicio auth ----------
NODE_ENV=development
PORT=3001
# URL pública canónica del servicio (se usa para validar DPoP; nunca se toma de la cabecera Host)
PUBLIC_BASE_URL=http://localhost:3001
# Número de proxies de confianza delante del servicio (ALB = 1)
TRUST_PROXY_HOPS=0
# Orígenes del navegador con CORS (solo el panel de administración; en producción https://admin.<dominio>)
CORS_ORIGINS=http://localhost:4100

DATABASE_URL=postgres://intitaxi:CAMBIAR@localhost:5432/intitaxi
# Ruta al certificado CA de RDS (obligatorio en producción)
DATABASE_SSL_CA=
REDIS_URL=redis://:CAMBIAR@localhost:6379/0
REDIS_TLS=false

# Cifrado de campos: "local" solo en desarrollo; producción exige "kms"
KEY_PROVIDER=local
# Generar con: openssl rand -base64 32
LOCAL_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=us-east-1
# Generar con: openssl rand -base64 32
BLIND_INDEX_KEY=
# Generar con: openssl rand -base64 32
OTP_PEPPER=

# Clave ES256 de firma de tokens (PKCS#8 PEM; usar \n para saltos de línea)
# Generar con: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
JWT_SIGNING_KEY_PEM=
JWT_SIGNING_KID=dev-1
JWT_PREVIOUS_PUBLIC_JWKS={"keys":[]}
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
API_AUDIENCE=intitaxi-api
CLIENT_IDS=intitaxi-passenger,intitaxi-driver

# Atestación de la app: "dev" solo en local; producción exige "enforce"
ATTESTATION_MODE=dev
ANDROID_PACKAGE_NAMES=ec.intitaxi.passenger,ec.intitaxi.driver
# Paquetes donde se tolera Android rooteado/no certificado (con señal de riesgo)
PLAY_INTEGRITY_ALLOW_BASIC_PACKAGES=ec.intitaxi.passenger
# App Attest (iOS): <TEAMID>.<bundle id>, y ruta a la Apple App Attestation Root CA
APP_ATTEST_APP_IDS=
APP_ATTEST_ROOT_CA_FILE=
APP_ATTEST_ENVIRONMENT=development
# Huellas SHA-256 del certificado de firma de Play (separadas por comas)
ANDROID_CERT_SHA256=
# Ruta al JSON de la cuenta de servicio de Google Play Integrity
PLAY_INTEGRITY_CREDENTIALS_FILE=

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Inti Taxi
# Orígenes permitidos: https://intitaxi.ec y android:apk-key-hash:<hash>
WEBAUTHN_ORIGINS=http://localhost:3001,http://localhost:4100

# Notificaciones: producción exige infobip / ses. "devbox" (simulador) y "console" solo en desarrollo
SMS_PROVIDER=console
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=IntiTaxi
EMAIL_PROVIDER=console
SES_FROM=
SES_CONFIGURATION_SET=
EMAIL_VERIFY_URL=http://localhost:3000/verificar-correo

# ---------- Servicio api (y sos: mismo binario, main-sos.js) ----------
# PORT=3002
# PUBLIC_BASE_URL=http://localhost:3002
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/jwks
API_AUDIENCE=intitaxi-api
# Endpoints /v1/dev/* para el simulador. Prohibido en producción.
DEV_TOOLS=false
# Verificación de identidad: producción exige "veriff"
KYC_PROVIDER=mock
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
# Secreto HMAC del proveedor simulado (openssl rand -base64 32)
WEBHOOK_SECRET_KYC=
KYC_PROVIDER_RETENTION_DAYS=30
REVERIFY_PROBABILITY=0.2

# ---------- Pruebas ----------
# DATABASE_URL/REDIS_URL de pruebas de integración y E2E_* para e2e (bases distintas; se BORRAN en cada ejecución)
E2E_DATABASE_URL=
E2E_REDIS_URL=
# Llamadas firmadas entre servicios (auth y api deben compartirlo; además de mTLS)
INTERNAL_SIGNING_SECRET=
INTERNAL_AUTH_URL=http://localhost:3001
# Mapas: producción exige "google" (Routes API, clave de servidor restringida por IP)
MAPS_PROVIDER=estimator
GOOGLE_MAPS_API_KEY=
# Tarifa bajo demanda en centavos (valores de EJEMPLO)
FARE_BASE_CENTS=150
FARE_PER_KM_CENTS=40
FARE_PER_MIN_CENTS=10
FARE_MIN_CENTS=200
MATCHING_OFFER_TTL_SECONDS=15
MATCHING_RADIUS_M=5000
MATCHING_MAX_RADIUS_M=8000
# Documentos de conductores: producción exige s3 con SSE-KMS
STORAGE_DRIVER=local
S3_BUCKET=
S3_KMS_KEY_ID=
VEHICLE_MAX_AGE_YEARS=15
MANIFEST_RETENTION_DAYS=180
TRACKING_BASE_URL=http://localhost:3004
SUBJECT_PORTAL_URL=http://localhost:3002

# ---------- Servicio realtime (WebSocket + página pública de seguimiento) ----------
# PORT=3004
# PUBLIC_BASE_URL=http://localhost:3004
# Teselas del mapa (producción: proveedor con contrato)
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAX_CONNECTIONS_PER_USER=5
# Pagos: producción exige "kushki" (PCI DSS nivel 1). "mock" solo desarrollo
PAYMENT_GATEWAY=mock
KUSHKI_BASE_URL=https://api-uat.kushkipagos.com
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SECRET=
WEBHOOK_SECRET_PAYMENTS=
PLATFORM_COMMISSION_BPS=2000
PAYOUT_MIN_CENTS=500
PAYOUT_ACCOUNT_COOLDOWN_HOURS=72
# ECU 911: "mock" (desarrollo; NUNCA contacta al 911 real), "signed_link" (sin convenio), "agreement" (con convenio, mTLS)
ECU911_ADAPTER=mock
ECU911_ENDPOINT=
ECU911_CLIENT_CERT_FILE=
ECU911_CLIENT_KEY_FILE=
ECU911_CA_FILE=
ECU911_AUTO_ESCALATE_SECONDS=60
# Firma de manifiestos (ES256 PKCS#8; producción: clave asimétrica de KMS)
MANIFEST_SIGNING_KEY_PEM=
MANIFEST_SIGNING_KID=manifest-1
# openssl rand -base64 32
SAFETY_PIN_PEPPER=
AUDIO_RETENTION_DAYS=90
AUTHORITY_LINK_HOURS=24

# --- Panel de administración (apps/admin-web) ---
ADMIN_AUTH_URL=http://localhost:3001
ADMIN_API_URL=http://localhost:3002
ADMIN_SOS_URL=http://localhost:3003
# Solo desarrollo: usar las passkeys del simulador para entrar al panel. Prohibido en producción.
ADMIN_DEV_AUTHENTICATOR_URL=
