# =====================================================================
# Inti Taxi — variables de entorno de EJEMPLO (sin valores reales).
# Copiar a .env (ignorado por git) solo para desarrollo local.
# En staging/producción los secretos se inyectan desde AWS Secrets Manager.
# =====================================================================

# ---------- Servicio auth ----------
NODE_ENV=development
PORT=3001
# URL pública canónica del servicio (se usa para validar DPoP; nunca se toma de la cabecera Host)
PUBLIC_BASE_URL=http://localhost:3001
# Número de proxies de confianza delante del servicio (ALB = 1)
TRUST_PROXY_HOPS=0

DATABASE_URL=postgres://intitaxi:CAMBIAR@localhost:5432/intitaxi
# Ruta al certificado CA de RDS (obligatorio en producción)
DATABASE_SSL_CA=
REDIS_URL=redis://:CAMBIAR@localhost:6379/0
REDIS_TLS=false

# Cifrado de campos: "local" solo en desarrollo; producción exige "kms"
KEY_PROVIDER=local
# Generar con: openssl rand -base64 32
LOCAL_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=us-east-1
# Generar con: openssl rand -base64 32
BLIND_INDEX_KEY=
# Generar con: openssl rand -base64 32
OTP_PEPPER=

# Clave ES256 de firma de tokens (PKCS#8 PEM; usar \n para saltos de línea)
# Generar con: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
JWT_SIGNING_KEY_PEM=
JWT_SIGNING_KID=dev-1
JWT_PREVIOUS_PUBLIC_JWKS={"keys":[]}
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_DAYS=30
API_AUDIENCE=intitaxi-api
CLIENT_IDS=intitaxi-passenger,intitaxi-driver

# Atestación de la app: "dev" solo en local; producción exige "enforce"
ATTESTATION_MODE=dev
ANDROID_PACKAGE_NAMES=ec.intitaxi.passenger,ec.intitaxi.driver
# Huellas SHA-256 del certificado de firma de Play (separadas por comas)
ANDROID_CERT_SHA256=
# Ruta al JSON de la cuenta de servicio de Google Play Integrity
PLAY_INTEGRITY_CREDENTIALS_FILE=

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Inti Taxi
# Orígenes permitidos: https://intitaxi.ec y android:apk-key-hash:<hash>
WEBAUTHN_ORIGINS=http://localhost:3001

# Proveedores de notificación: "console" solo en desarrollo
SMS_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_VERIFY_URL=http://localhost:3000/verificar-correo
