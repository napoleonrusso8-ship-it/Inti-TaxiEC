{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:unit": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"], "env": ["DATABASE_URL", "REDIS_URL"] }
  }
}
